# Copy to .env — scripts/deploy.sh installs this as data/.env (the HERMES_HOME .env).

# ── LLM provider (at least one) ─────────────────────────────────────────────
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# NOUS_API_KEY=

# ── Design tooling ──────────────────────────────────────────────────────────
# FAL_KEY=              # image_generate tool (FLUX)
# BROWSERBASE_API_KEY=  # browser tools (moodboards, reference hunting)

# ── Eternal game → agent signal push (webhook server in `hermes gateway`) ───
# Generate a secret with: openssl rand -hex 32
# The game signs POSTs to /webhooks/eternal-signal with
# X-Hub-Signature-256: sha256=<hmac-sha256(raw_body, WEBHOOK_SECRET)>
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644
WEBHOOK_SECRET=

# ── Messaging gateway (optional) ────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# ── Docker file ownership (docker mode) ─────────────────────────────────────
# HERMES_UID=1000
# HERMES_GID=1000
